@model BlogDetailViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-4">
    <h1 class="display-4">@Model.Title</h1>
    @if (!string.IsNullOrEmpty(Model.Subtitle))
    {
        <h2 class="h4 text-muted mb-3">@Model.Subtitle</h2>
    }

    <p class="mb-4">By: @Model.AuthorEmail</p>

    @if (!string.IsNullOrEmpty(Model.Description))
    {
        <div class="card mb-4">
            <div class="card-body">
                <p class="card-text">@Model.Description</p>
            </div>
        </div>
    }

    <h3 class="h4 mb-3">Recent Posts</h3>
    @if (Model.RecentPosts.Any())
    {
        <div class="list-group mb-4">
            @foreach (var post in Model.RecentPosts)
            {
                <a asp-controller="Community" asp-action="ViewPost" asp-route-id="@post.PostId"
                   class="list-group-item list-group-item-action">
                    <div class="d-flex w-100 justify-content-between">
                        <h5 class="mb-1">@post.Title</h5>
                        <small class="text-muted">@post.CreatedAt.ToShortDateString()</small>
                    </div>
                </a>
            }
        </div>

        <a asp-controller="Community" asp-action="ViewAllPosts" asp-route-blogId="@Model.BlogId"
           class="btn btn-outline-primary">View All Posts</a>
    }
    else
    {
        <p class="text-muted">No posts yet.</p>
    }

    <div class="mt-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
            Back to Blogs
        </a>
    </div>
</div>