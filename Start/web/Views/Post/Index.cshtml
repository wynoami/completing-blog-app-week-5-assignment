@model IEnumerable<AtlasBlog.Models.EF.Post>

@{
    ViewData["Title"] = "All Posts";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>All Posts</h1>
        <a asp-action="Create" class="btn btn-primary">Create New Post</a>
    </div>

    @if (!Model.Any())
    {
        <p>No posts yet. Create your first post to get started!</p>
    }
    else
    {
        <div class="list-group">
            @foreach (var post in Model)
            {
                <div class="list-group-item bg-light">
                    <div class="d-flex w-100 justify-content-between">
                        <h5 class="mb-1">@post.Title</h5>
                        <small>@post.CreatedAt.ToShortDateString()</small>
                    </div>
                    <p class="mb-1">Last modified: @post.LastModifiedAt.ToShortDateString()</p>
                    <a asp-action="Edit" asp-route-id="@post.PostId" class="btn btn-sm btn-outline-primary">Edit</a>
                </div>
            }
        </div>
    }
</div>